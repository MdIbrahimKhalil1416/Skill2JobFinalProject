# Local settings. Copy this file to ".env" (same folder as pom.xml) and fill in your values.
# The app reads .env automatically when you run it from the project folder (IntelliJ or mvn spring-boot:run).
# Never commit the real .env file. On Render, set these as Environment Variables instead.

# MongoDB Atlas connection string (leave this line out to use a local MongoDB on localhost:27017)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/skill2job?retryWrites=true&w=majority

# LOCAL DEVELOPMENT: every setting in this file is optional - the default "dev" profile has its own development
# JWT secret, admin account (admin@skill2job.com / Admin@123) and demo data, so the app runs with only MongoDB.
# PRODUCTION (SPRING_PROFILES_ACTIVE=prod, e.g. Render): JWT_SECRET, ADMIN_EMAIL and ADMIN_PASSWORD are REQUIRED
# and are validated at startup - the app refuses to start with a missing, short, placeholder or default value.
# NEVER put real production values in a file that is committed; set them in the Render dashboard instead.

# At least 32 random characters (e.g. `openssl rand -base64 48`). Example placeholders are rejected in production.
JWT_SECRET=

# Admin account created on the first start of an empty database. An existing account is never changed.
# In production the password needs 10+ characters with letters and digits and must not be a known default.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Demo users/jobs/courses. ON in the dev profile, OFF in production. Production ignores SEED_ENABLED=true unless
# SEED_ALLOW_IN_PROD=true is set as well (do not do that on a real deployment).
# SEED_ENABLED=true
# SEED_ALLOW_IN_PROD=false

# Email (signup OTP). Leave these blank to skip real email - the OTP is then only printed to the
# server log (dev profile only; see app.otp.log-to-console). For Gmail, MAIL_PASSWORD must be a
# 16-character "app password" (Google Account -> Security -> App passwords), not your login password.
# (In production, without MAIL_USERNAME nobody can receive a signup code, so new users cannot verify their email.)
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional: defaults to MAIL_USERNAME. With Brevo this must be a sender you verified in Brevo.
MAIL_FROM=
# Email verification at signup (6-digit code by email). Off by default: new accounts are active at once.
# Set to true only when email sending works (BREVO_API_KEY on Render, or SMTP locally).
# EMAIL_VERIFICATION_ENABLED=false
# Brevo transactional email (HTTPS API). REQUIRED on Render's free plan, which blocks SMTP ports.
# When set it is used instead of SMTP; MAIL_PASSWORD is then not needed. Create it in Brevo > SMTP & API > API keys.
BREVO_API_KEY=
# Optional display name of the sender (default Skill2Job)
MAIL_FROM_NAME=

# Where uploaded CVs are stored on disk. Defaults to ./uploads/cv (relative to where the app runs).
CV_UPLOAD_DIR=./uploads/cv

# Where uploaded company logos are stored on disk (company branding feature).
LOGO_UPLOAD_DIR=./uploads/logos

# Payments (SSLCommerz sandbox) - employer job-posting fee + Pro subscription.
# The app's own public base URL, used to build the success/fail/cancel/ipn callback URLs that
# SSLCommerz redirects back to. "http://localhost:8080" is fine for local testing - SSLCommerz
# redirects the CUSTOMER'S BROWSER there, which works on localhost. The ipn_url is a separate
# server-to-server call from SSLCommerz's own servers, so it only works when APP_BASE_URL is a
# real, publicly reachable URL (e.g. your Render URL) - on localhost it is simply never called,
# and the success/fail/cancel redirect flow still works fine without it.
APP_BASE_URL=http://localhost:8080

# SSLCommerz SANDBOX credentials (no real money). testbox/qwerty are SSLCommerz's own published demo values and
# may be shared/unreliable. If they stop working, register a free personal sandbox store at
# https://developer.sslcommerz.com/registration/ and put your own store_id/store_passwd here -
# nothing else needs to change.
# The app never switches to live payments by itself. SSLCOMMERZ_SANDBOX=false (real money) is only accepted in
# production together with YOUR OWN live store id/password and an https APP_BASE_URL.
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_SANDBOX=true

# Pricing (BDT). Employers get FREE_JOB_POSTS lifetime job posts for free; after that, posting a
# new job costs JOB_POST_FEE unless they have an active Pro subscription (SUBSCRIPTION_PRICE for
# SUBSCRIPTION_DAYS days, renewable).
FREE_JOB_POSTS=2
JOB_POST_FEE=500
SUBSCRIPTION_PRICE=2000
SUBSCRIPTION_DAYS=30

# Public URL of the app, used for links inside emails (job alerts, password reset).
APP_BASE_URL=http://localhost:8080

# Skill tests: questions per test, time limit, and how long before the same skill can be retaken.
QUIZ_QUESTIONS_PER_TEST=5
QUIZ_TIME_LIMIT_MINUTES=10
QUIZ_COOLDOWN_MINUTES=30

# Job alerts are checked on this Spring cron schedule (sec min hour day month weekday).
JOB_ALERTS_CRON=0 */15 * * * *

# Forgot-password codes expire after this many minutes.
PASSWORD_RESET_EXPIRY_MINUTES=15

# Student Pro (BDT price and number of days per purchase).
STUDENT_PRO_PRICE=299
STUDENT_PRO_DAYS=30

# Rate limits on login/signup/OTP/forgot-password. CLIENT_IP_HOPS = reverse proxies in front of the app (Render = 1).
RATE_LIMIT_ENABLED=true
CLIENT_IP_HOPS=1
